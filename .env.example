# Optional CDN/static-host mirror of the bundled assistant recordings.
# Expected path: <base>/audio/assistant/<language>/<section>.mp3
VITE_ASSISTANT_AUDIO_BASE_URL=

# MedLoop cloud API gateway (Cloudflare Worker) base URL, e.g.
# https://medloop-api.<subdomain>.workers.dev  — leave empty to keep the app
# fully offline / local-first (no cloud calls are made).
VITE_MEDLOOP_API_URL=

