# Local secrets for `wrangler dev`. Copy this file to `.dev.vars` (gitignored)
# and fill in the values. In production set each one with:
#   wrangler secret put <NAME>

# Signing/entropy secret for the gateway (any long random string).
TOKEN_SIGNING_SECRET=

# Firebase Cloud Messaging — HTTP v1 API service-account credentials (Module C).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp Cloud API — optional secondary alert channel (Module C).
# See docs/WHATSAPP_SETUP.md. Without a template name, sends free-form text
# (only valid within the 24h window — for testing). Set WHATSAPP_TEMPLATE_NAME
# to an approved template for production proactive alerts.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=medloop_alert
# WHATSAPP_TEMPLATE_LANG=en

# Email channel — optional. Uses Resend's HTTP API when both are set.
RESEND_API_KEY=
EMAIL_FROM=

# MedLoop AI assistant (feature #8). The DEFAULT engine is Cloudflare Workers AI
# via the [ai] binding in wrangler.toml — no key needed. The vars below are all
# OPTIONAL: WORKERS_AI_MODEL overrides the open model; MEDLOOP_AI_API_KEY (+
# MEDLOOP_AI_MODEL) switches to an Anthropic fallback instead; AI_RATE_LIMIT_MAX
# overrides the per-user hourly limit. Without any engine, /ai/* still enforces
# the guardrails and returns a safe fallback.
# WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
MEDLOOP_AI_API_KEY=
# MEDLOOP_AI_MODEL=claude-sonnet-5
# AI_RATE_LIMIT_MAX=20

# R2 file storage (prescription images) is enabled by creating the bucket and
# uncommenting [[r2_buckets]] in wrangler.toml — no secret required.
