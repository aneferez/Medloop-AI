{
  "name": "medloop-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MedLoop cloud backend — Cloudflare Worker API gateway + D1 data layer",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create medloop",
    "db:migrate": "wrangler d1 migrations apply medloop --remote",
    "db:migrate:local": "wrangler d1 migrations apply medloop --local",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
